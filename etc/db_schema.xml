<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="sales_countdown_rule" resource="default" engine="innodb" comment="Sales Countdown Rules">
        <column xsi:type="int" name="rule_id" unsigned="true" nullable="false" identity="true"
                comment="Entity ID"/>
        <column xsi:type="varchar" name="name" nullable="false" length="255" comment="Name"/>
        <column xsi:type="varchar" name="message" nullable="false" length="255" comment="Message"/>
        <column xsi:type="text" name="description" nullable="true" comment="Description"/>
        <column xsi:type="date" name="from_date" nullable="true" comment="From"/>
        <column xsi:type="date" name="to_date" nullable="true" comment="To"/>
        <column xsi:type="smallint" name="is_active" unsigned="false" nullable="false" identity="false"
                default="0" comment="Is Active"/>
        <column xsi:type="mediumtext" name="conditions_serialized" nullable="true" comment="Conditions Serialized"/>
        <column xsi:type="int" name="sort_order" unsigned="true" nullable="false" identity="false"
                default="0" comment="Sort Order"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="rule_id"/>
        </constraint>
        <index referenceId="SALES_COUNTDOWN_IS_ACTIVE_SORT_ORDER_TO_DATE_FROM_DATE" indexType="btree">
            <column name="is_active"/>
            <column name="sort_order"/>
            <column name="to_date"/>
            <column name="from_date"/>
        </index>
    </table>
    <table name="sales_countdown_rule_website" resource="default" engine="innodb"
           comment="Sales Countdown Rules To Websites Relations">
        <column xsi:type="int" name="rule_id" unsigned="true" nullable="false" identity="false"
                comment="Rule ID"/>
        <column xsi:type="smallint" name="website_id" unsigned="true" nullable="false" identity="false"
                comment="Website ID"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="rule_id"/>
            <column name="website_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="SALES_COUNTDOWN_WEBSITE_RULE_ID_SALES_COUNTDOWN_RULE_ID"
                    table="sales_countdown_rule_website" column="rule_id"
                    referenceTable="sales_countdown_rule" referenceColumn="rule_id"
                    onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="SALES_COUNTDOWN_WEBSITE_WEBSITE_ID_STORE_WEBSITE_WEBSITE_ID"
                    table="sales_countdown_rule_website" column="website_id"
                    referenceTable="store_website" referenceColumn="website_id" onDelete="CASCADE"/>
        <index referenceId="SALES_COUNTDOWN_WEBSITE_WEBSITE_ID" indexType="btree">
            <column name="website_id"/>
        </index>
    </table>
    <table name="sales_countdown_rule_customer_group" resource="default" engine="innodb"
           comment="Sales Countdown Rules To Customer Groups Relations">
        <column xsi:type="int" name="rule_id" unsigned="true" nullable="false" identity="false"
                comment="Rule ID"/>
        <column xsi:type="int" name="customer_group_id" unsigned="true" nullable="false" identity="false"
                comment="Customer Group ID"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="rule_id"/>
            <column name="customer_group_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="SALES_COUNTDOWN_CUSTOMER_GROUP_RULE_ID_SALES_COUNTDOWN_RULE_ID"
                    table="sales_countdown_rule_customer_group" column="rule_id"
                    referenceTable="sales_countdown_rule" referenceColumn="rule_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign"
                    referenceId="SALES_COUNTDOWN_CSTR_GROUP_CSTR_GROUP_ID_CSTR_GROUP_CSTR_GROUP_ID"
                    table="sales_countdown_rule_customer_group" column="customer_group_id"
                    referenceTable="customer_group"
                    referenceColumn="customer_group_id" onDelete="CASCADE"/>
        <index referenceId="SALES_COUNTDOWN_CUSTOMER_GROUP_CUSTOMER_GROUP_ID" indexType="btree">
            <column name="customer_group_id"/>
        </index>
    </table>
    <table name="sales_countdown_rule_product" resource="default" engine="innodb"
           comment="Sales Countdown Rules To Products Relations">
        <column xsi:type="int" name="rule_product_id" unsigned="true" nullable="false" identity="true"
                comment="Rule Product ID"/>
        <column xsi:type="int" name="rule_id" unsigned="true" nullable="false" identity="false" default="0"
                comment="Rule ID"/>
        <column xsi:type="int" name="from_time" unsigned="true" nullable="false" identity="false"
                default="0" comment="From Time"/>
        <column xsi:type="int" name="to_time" unsigned="true" nullable="false" identity="false" default="0"
                comment="To time"/>
        <column xsi:type="int" name="customer_group_id" unsigned="false" nullable="true" identity="false"/>
        <column xsi:type="int" name="product_id" unsigned="true" nullable="false" identity="false"
                default="0" comment="Product ID"/>
        <column xsi:type="smallint" name="website_id" unsigned="true" nullable="false" identity="false"
                comment="Website ID"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="rule_product_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="SCR_PRD_RULE_ID_FR_TIME_TO_TIME_WS_ID_CSTR_GROUP_ID_PRD_ID">
            <column name="rule_id"/>
            <column name="from_time"/>
            <column name="to_time"/>
            <column name="website_id"/>
            <column name="customer_group_id"/>
            <column name="product_id"/>
        </constraint>
        <index referenceId="SALES_COUNTDOWN_PRODUCT_CUSTOMER_GROUP_ID" indexType="btree">
            <column name="customer_group_id"/>
        </index>
        <index referenceId="SALES_COUNTDOWN_PRODUCT_WEBSITE_ID" indexType="btree">
            <column name="website_id"/>
        </index>
        <index referenceId="SALES_COUNTDOWN_PRODUCT_FROM_TIME" indexType="btree">
            <column name="from_time"/>
        </index>
        <index referenceId="SALES_COUNTDOWN_PRODUCT_TO_TIME" indexType="btree">
            <column name="to_time"/>
        </index>
        <index referenceId="SALES_COUNTDOWN_PRODUCT_PRODUCT_ID" indexType="btree">
            <column name="product_id"/>
        </index>
    </table>
</schema>
